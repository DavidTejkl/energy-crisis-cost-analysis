table vw_monthly_cost
	lineageTag: 18c4a0ef-5b70-4062-bf28-65f06df719f0

	/// Celkový náklad na elektřinu vydělený spotřebou. Bez DPH.
	measure 'Celková cena elektřiny (Kč/kWh)' = DIVIDE([Celkový náklad na elektřinu (Kč)],SUM(vw_monthly_cost[load_mwh]))/1000
		lineageTag: b4d2c9a2-7811-4ce8-a80e-00075c7aab4c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Silová elektřina, distribuce, systémové služby, daň z elektřiny, POZE a poplatky OTE. Bez DPH.
	measure 'Celkový náklad na elektřinu (Kč)' = SUM(vw_monthly_cost[total_cost_czk])
		lineageTag: 2684dde1-02b5-42d0-a5e4-3156c870177a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Jaký podíl celkového nákladu na elektřinu tvoří silová elektřina (cena z trhu). Zbytek jsou regulované složky: distribuce, systémové služby, POZE a daň.
	measure 'Podíl silové elektřiny (%)' = DIVIDE(SUM(vw_monthly_cost[power_cost_czk]),[Celkový náklad na elektřinu (Kč)])
		formatString: 0.0\ %;-0.0\ %;0.0\ %
		lineageTag: 00eae37f-0146-4493-824b-7b0bd79cc015

	/// Kolikrát vyšší byl celkový náklad na elektřinu v roce 2022 než v roce 2020. Roky jsou pevné, výsledek nezávisí na výběru v reportu.
	measure 'Násobek nákladu krize (2022 / 2020)' =
			
			VAR cost_2022 =
			    CALCULATE ([Celkový náklad na elektřinu (Kč)],dim_date[year] = 2022 )
			VAR cost_2020 =
			    CALCULATE ([Celkový náklad na elektřinu (Kč)], dim_date[year] = 2020 )
			RETURN
			    DIVIDE ( cost_2022, cost_2020 )
		formatString: #,0.00
		lineageTag: 2541bb2a-a1d7-4d6f-881e-b5db881017e0

	/// Celkový náklad firmy na elektřinu v milionech Kč (silová elektřina, regulované složky, POZE). Jen pro zobrazení, počítá se z míry v Kč.
	measure 'Celkový náklad na elektřinu (mil. Kč)' = DIVIDE([Celkový náklad na elektřinu (Kč)],1000000)
		formatString: 0.00
		lineageTag: 9617c475-0344-4659-abd7-edc84cf9e7a6

	/// Celkový náklad na elektřinu v předchozím roce, v milionech Kč. Pro rok 2020 je prázdný, protože data začínají v roce 2020.
	measure 'Celkový náklad na elektřinu minulý rok (mil. Kč)' = CALCULATE([Celkový náklad na elektřinu (mil. Kč)],SAMEPERIODLASTYEAR(dim_date[full_date]))
		formatString: 0.00
		lineageTag: cb15d31b-cf63-4a1e-b44d-c119d31771b6

	/// Celková cena elektřiny za kWh ve stejném období předchozího roku. Pro srovnání na kartě.
	measure 'Celková cena elektřiny minulý rok (Kč/kWh)' = CALCULATE([Celková cena elektřiny (Kč/kWh)],SAMEPERIODLASTYEAR(dim_date[full_date]))
		formatString: 0.00
		lineageTag: 141ea787-68c2-40c8-845b-ef5291b1ca9b

	/// Platby za distribuci, systémové služby a daň z elektřiny, které se platí za každou odebranou MWh. Bez DPH.
	measure 'Regulované poplatky podle spotřeby (Kč)' = SUM(vw_monthly_cost[electricity_tax_czk]) + SUM(vw_monthly_cost[network_use_czk]) + SUM(vw_monthly_cost[system_services_czk])
		formatString: #,0.00
		lineageTag: ec12a4cf-b0fb-45dd-9e12-f2e3099667ff

	/// Měsíční platby, které nezávisí na spotřebě: rezervovaná kapacita 5 MW a poplatky OTE. Bez DPH.
	measure 'Pevné platby (Kč)' = ```
			SUM(vw_monthly_cost[reserved_capacity_czk]) + SUM(vw_monthly_cost[ote_fees_czk]) 
			```
		formatString: #,0.00
		lineageTag: 32ac6fb3-dcb3-46da-a22e-4c6ec4a3ba17

	/// Příspěvek na podporované zdroje energie (obnovitelné zdroje), počítaný z rezervované kapacity, nejvýš však podle limitu za MWh. Od 10/2022 do konce 2023 nulový. Bez DPH.
	measure 'POZE (Kč)' = SUM(vw_monthly_cost[poze_czk])
		formatString: #,0.00
		lineageTag: cbd61d66-1c4f-4db6-aa5f-e1c4b0f64ed0

	/// Všechny platby, které stanovuje ERÚ nebo zákon, ne trh: poplatky podle spotřeby, pevné platby a POZE. Bez DPH.
	measure 'Regulované platby (Kč)' = [Pevné platby (Kč)] + [POZE (Kč)] + [Regulované poplatky podle spotřeby (Kč)]
		formatString: #,0.00
		lineageTag: 58004907-9b5b-4ead-8542-240b4753dbe0

	/// Text pro kartu na stránce Shrnutí: náklad roku 2020 a kolikrát byl náklad 2022 vyšší.
	measure 'Karta – náklad 2020 a násobek' = ```
			
			VAR celkem2020 = CALCULATE([Celkový náklad na elektřinu (mil. Kč)],dim_date[year] = 2020)
			VAR nasobek = [Násobek nákladu krize (2022 / 2020)]
			RETURN
			"2020: " & FORMAT(celkem2020, "0.00") & " mil. Kč · " & FORMAT(nasobek, "0.0") & "× více "
			
			```
		lineageTag: 6cc400cc-ad6b-45f8-b92f-046f0b8b59b2

	/// Text pro kartu na stránce Shrnutí: celková cena elektřiny v roce 2020 v Kč/kWh (srovnání s kartou za rok 2022).
	measure 'Karta – cena 2020' =
			
			VAR cena2020 = CALCULATE([Celková cena elektřiny (Kč/kWh)], dim_date[year] = 2020)
			RETURN
			"2020: " & FORMAT(cena2020, "0.00") & " Kč/kWh"
		lineageTag: 85cc8db7-7c5c-4fef-b0e9-c9ceeb6aff90

	/// Regulované platby (distribuce, systémové služby, daň, rezervovaný příkon, POZE, poplatky OTE) v milionech Kč.
	measure 'Regulované platby (mil. Kč)' = DIVIDE([Regulované platby (Kč)],1000000)
		formatString: #0.00
		lineageTag: a63278e4-0811-482b-84e0-8feaa0f00efc

		annotation PBI_FormatHint = {"isCustom":true}

	/// Text pro kartu na stránce Shrnutí: regulované platby v roce 2024 a kolikrát byly vyšší než ve vybraném roce (na kartě 2022).
	measure 'Karta – regulované platby 2024' =
			
			VAR reg2024 = CALCULATE([Regulované platby (mil. Kč)],dim_date[year] = 2024)
			VAR reg2022 = [Regulované platby (mil. Kč)]
			RETURN
			"2024: " & FORMAT(reg2024, "0.00") & " mil. Kč · " & FORMAT(DIVIDE(reg2024,reg2022), "0.0") & "× více"
		lineageTag: 459f3698-6f74-4416-b370-c43120994869

	measure 'Nejdražší měsíc – celkový náklad (Kč)' = MAX(vw_monthly_cost[total_cost_czk])
		formatString: #,0.00
		lineageTag: 334522f5-98cf-4e27-a92a-9a92239fb142

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Nejdražší měsíc karta – celkový náklad (mil. Kč)' = DIVIDE([Nejdražší měsíc – celkový náklad (Kč)],1000000)
		formatString: #,0.00
		lineageTag: c28115e5-6115-4763-a335-e2f20adaaed9

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Nejdražší měsíc karta – spodni' = ```
			
			VAR cena = CALCULATE([Celková cena elektřiny (Kč/kWh)],vw_monthly_cost[year] = 2022,vw_monthly_cost[month] = 8)
			RETURN 
			"Srpen 2022" & " · " & FORMAT(cena, "0.00") & " Kč/kWh"
			```
		lineageTag: ac0be9a9-5366-4066-9d07-130518af83e3

	measure 'Nejlevnější měsíc - celkový náklad' = ```
			MIN(vw_monthly_cost[total_cost_czk]) 
			```
		lineageTag: ea6fc093-2f4b-4c7d-82c0-4dd77b6bb66d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Nejlevnější měsíc karta - celkový náklad (mil. Kč)' = ```
			DIVIDE([Nejlevnější měsíc - celkový náklad],1000000) 
			```
		lineageTag: 1445da4b-dd7e-4432-a8b3-285a1b101996

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Nejlevnější měsíc karta - spodní' =
			
			VAR cena = CALCULATE([Celková cena elektřiny (Kč/kWh)],vw_monthly_cost[year] = 2020, vw_monthly_cost[month] = 4)
			RETURN
			"Duben 2020 (Covid)" & " · " & FORMAT(cena, "0.00") & " Kč/kWh"
		lineageTag: bd979ffb-780a-48b6-bece-810eff7d6282

