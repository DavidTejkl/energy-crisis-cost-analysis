table vw_yearly_hedging
	lineageTag: 248e0779-9932-4ea1-a3e1-8d44fbd7b0fa

	/// Náklad na silovou elektřinu v EUR, kdyby firma nic nezajistila a vše koupila na denním trhu OTE. Výchozí bod pro srovnání se zajištěním.
	measure 'Náklad na silovou elektřinu bez zajištění (EUR)' = ```
			SUM(vw_yearly_hedging[spot_cost_eur]) 
			```
		formatString: #,0.00
		lineageTag: 57c5891d-1047-4dfe-92c1-2332e88bce13

	/// Náklad na silovou elektřinu v EUR, když firma zvolený podíl spotřeby koupí předem za pevnou cenu a zbytek na denním trhu. Pevná cena je proxy tzn. náhradní cena: průměr denního trhu v předchozím roce, protože skutečné forwardové ceny OTE nezveřejňuje (ADR-003). Podíl se volí posuvníkem. Simulace.
	measure 'Náklad na silovou elektřinu se zajištěním - proxy (EUR)' =
			
			VAR no_hedge = [Náklad na silovou elektřinu bez zajištění (EUR)]
			VAR parameter = [Hodnota parametru Podíl zajištění]
			VAR hedge_diff = SUM(vw_yearly_hedging[hedge_diff_proxy_eur])
			RETURN
			no_hedge + parameter * hedge_diff
		formatString: #,0.00
		lineageTag: 736a3e8c-5b2f-4d8e-b242-4e4cdcd09935

	/// Náklad na silovou elektřinu v EUR, když firma zvolený podíl spotřeby koupí předem za skutečnou burzovní cenu PXE (roční produkt na příští rok, poslední obchod v prosinci) a zbytek na denním trhu. Cenu PXE máme pro roky 2022–2024, rok 2021 zůstává prázdný. Podíl se volí posuvníkem. Simulace.
	measure 'Náklad na silovou elektřinu se zajištěním - PXE (EUR)' = ```
			
			VAR no_hedging = [Náklad na silovou elektřinu bez zajištění (EUR)]
			VAR param = [Hodnota parametru Podíl zajištění]
			VAR pxe = SUM(vw_yearly_hedging[hedge_diff_pxe_eur])
			RETURN
			IF(ISBLANK(pxe),BLANK(),no_hedging + param * pxe) 
			```
		formatString: #,0.00
		lineageTag: a436cbd6-3076-46ab-9b34-92f9824ac69e

	/// Rozdíl mezi nákladem na silovou elektřinu se zajištěním za náhradní (proxy) cenu a nákladem bez zajištění, v EUR. Záporné číslo znamená, že nákup předem by byl levnější, kladné, že by byl dražší. Po letech ukazuje každý rok zvlášť, bez filtru roku ukazuje součet za 2021–2024. Podíl se volí posuvníkem. Simulace.
	measure 'Výsledek zajištění - proxy (EUR)' =
			
			VAR no_hedging = [Náklad na silovou elektřinu bez zajištění (EUR)]
			VAR proxy = [Náklad na silovou elektřinu se zajištěním - proxy (EUR)]
			RETURN
			proxy - no_hedging
		formatString: #,0.00
		lineageTag: bb0b3f1d-786b-45ff-8ede-11f5705ca114

