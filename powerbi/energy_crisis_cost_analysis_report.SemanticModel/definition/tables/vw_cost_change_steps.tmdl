table vw_cost_change_steps
	lineageTag: bb7e2d07-daad-4afe-be41-4688f98ecfa8

	/// Hodnota jednoho kroku vodopádu: loňský náklad na silovou elektřinu, nebo vliv objemu, tržní ceny, diagramu odběru a kurzu na jeho změnu.
	measure 'Krok změny nákladu (Kč)' = SUM(vw_cost_change_steps[amount_czk])
		formatString: #,0.00
		lineageTag: 1bf3a75f-34c7-478e-801e-74f33bf33605

	/// O kolik Kč změnil náklad na silovou elektřinu pohyb kurzu EUR/CZK oproti předchozímu roku. Záporné = silnější koruna snížila náklad.
	measure 'Vliv kurzu (Kč)' = CALCULATE([Krok změny nákladu (Kč)],vw_cost_change_steps[step_name] = "Kurz EUR/CZK")
		formatString: #,0.00
		lineageTag: 8d1922dd-27c2-4fda-b9a9-b862faccdc27

	/// O kolik změnila náklad na silovou elektřinu oproti minulému roku samotná změna tržní ceny (OTE), při letošní spotřebě. Kladné číslo = náklad zvýšila.
	measure 'Vliv ceny na trhu (Kč)' = CALCULATE([Krok změny nákladu (Kč)],vw_cost_change_steps[step_name] = "Cena na trhu")
		formatString: 0.00
		lineageTag: 1cbc63ae-1306-4f88-b634-e2878e9120e8

	/// Vliv ceny na trhu převedený na miliony Kč pro zobrazení na kartě.
	/// 
	measure 'Vliv ceny na trhu (mil. Kč)' = DIVIDE([Vliv ceny na trhu (Kč)],1000000)
		formatString: +#,0.00;-#,0.00;0.00
		lineageTag: 13dcd101-8898-44be-ac42-efa2942c99bc

		annotation PBI_FormatHint = {"isCustom":true}

	/// Vliv změny kurzu EUR/CZK převedený na miliony Kč pro zobrazení na kartě. Záporné číslo = silnější koruna náklad snížila.
	measure 'Vliv kurzu (mil. Kč)' = DIVIDE([Vliv kurzu (Kč)],1000000)
		formatString: +#,0.00;-#,0.00;0.00
		lineageTag: a200d8fe-71dc-41b9-8e03-bace8d9a65f8

		annotation PBI_FormatHint = {"isCustom":true}

	measure 'Krok změny nákladu (mil. Kč)' = DIVIDE([Krok změny nákladu (Kč)],1000000)
		formatString: +#,0.00;-#,0.00;0.00
		lineageTag: 09e69c4e-9093-4d67-888d-ac17b1f6de8e

		annotation PBI_FormatHint = {"isCustom":true}

	column date_key
		dataType: int64
		formatString: 0
		lineageTag: 99eb4e5c-f031-4637-8a0f-f67d929bc56c
		summarizeBy: none
		sourceColumn: date_key

		annotation SummarizationSetBy = Automatic

	column year
		dataType: int64
		formatString: 0
		lineageTag: fb228d17-06d7-4560-b28a-c263b549243f
		summarizeBy: none
		sourceColumn: year

		annotation SummarizationSetBy = User

	column step_order
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 4e6f1cd2-c3a3-4cff-a17a-3a19f0d61c76
		summarizeBy: sum
		sourceColumn: step_order

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	column step_name
		dataType: string
		lineageTag: fc5623c7-4079-46e0-8d81-2fd5bca48604
		summarizeBy: none
		sourceColumn: step_name
		sortByColumn: step_order

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	column amount_czk
		dataType: double
		lineageTag: f5c7a1c7-0368-4b2e-bc5f-c989dbafa49a
		summarizeBy: sum
		sourceColumn: amount_czk

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition vw_cost_change_steps = m
		mode: import
		source =
				let
				    Zdroj = Sql.Database("localhost", "EnergyCrisisCostAnalysis"),
				    dbo_vw_cost_change_steps = Zdroj{[Schema="dbo",Item="vw_cost_change_steps"]}[Data]
				in
				    dbo_vw_cost_change_steps

	annotation PBI_ResultType = Table

