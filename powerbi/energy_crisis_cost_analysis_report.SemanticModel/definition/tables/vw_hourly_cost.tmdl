table vw_hourly_cost
	lineageTag: af918e86-24be-4391-a9f6-a910874fe3cc

	/// Náklad na elektřinu nakoupenou na denním trhu OTE. Bez distribuce, poplatků a DPH.
	measure 'Náklad na silovou elektřinu (Kč)' = SUM(vw_hourly_cost[power_cost_czk])
		formatString: #,0.00
		lineageTag: e2b6e9fd-21e5-4e17-8504-fe1423b9a3bf

	/// Spotřeba elektřiny firmy. Simulovaný profil, viz metodika.
	measure 'Spotřeba (MWh)' = SUM(vw_hourly_cost[load_mwh])
		lineageTag: 7b37902a-c484-48bc-9081-37798eb89a90

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Náklad na silovou elektřinu vydělený spotřebou.
	measure 'Cena za silovou elektřinu (Kč/MWh)' = DIVIDE([Náklad na silovou elektřinu (Kč)],[Spotřeba (MWh)])
		lineageTag: 315d0a2c-6006-4f96-b70a-b0aaa53e68dc

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Náklad na silovou elektřinu vydělený spotřebou a přepočtený na kWh.
	measure 'Cena za silovou elektřinu (Kč/kWh)' = ```
			[Cena za silovou elektřinu (Kč/MWh)]/1000 
			```
		lineageTag: 18a6530f-cb69-4e7c-8c34-957944104031

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Prostý průměr hodinových cen denního trhu OTE. Každá hodina má stejnou váhu, spotřeba firmy se nepoužívá.
	measure 'Průměrná tržní cena (Kč/MWh)' = AVERAGE(vw_hourly_cost[price_czk_mwh])
		lineageTag: 4c6b9caa-8148-4852-ba70-66d1fa31ba63

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// O kolik firma platí za MWh víc než tržní průměr, protože odebírá víc v dražších hodinách. Cena za silovou elektřinu minus průměrná tržní cena. Simulovaný profil spotřeby.
	measure 'Přirážka za diagram odběru (Kč/MWh)' = [Cena za silovou elektřinu (Kč/MWh)] - [Průměrná tržní cena (Kč/MWh)]
		formatString: 0.00
		lineageTag: 24c5d725-5692-4a21-8d2c-66d59f1e12e0

	/// O kolik korun firma za období zaplatila víc, než kdyby stejné množství odebírala rovnoměrně za tržní průměr. Přirážka za MWh * spotřeba. Počítá se na jeden rok. Simulovaný profil spotřeby.
	measure 'Přirážka za diagram odběru (Kč)' = [Přirážka za diagram odběru (Kč/MWh)] * [Spotřeba (MWh)]
		formatString: #,0.00
		lineageTag: 26b6e798-7b16-473a-a8ee-0f332892f31b

	/// Počet hodin s cenou na denním trhu alespoň 5 821 Kč/MWh (pásmo „extrémní“, 90. percentil let 2020–2024).
	measure 'Extrémní hodiny' = CALCULATE(COUNTROWS(vw_hourly_cost),vw_hourly_cost[price_czk_mwh] >= 5821) + 0
		formatString: 0
		lineageTag: 1d0c1bc3-c32b-444e-b88d-a9db300915ea

	/// Nejvyšší cena jedné hodiny na denním trhu OTE ve vybraném období.
	measure 'Nejvyšší hodinová cena (Kč/MWh)' = MAX(vw_hourly_cost[price_czk_mwh])
		formatString: #,0.00
		lineageTag: f0da7315-cfdc-4768-b571-9767a0bec4e0

	/// Prostý průměr hodinových cen v pracovní dny, 8:00–20:00 (definice peak na trhu PXE/EEX). Svátky ve všední den se počítají jako špička.
	measure 'Průměrná cena ve špičce (Kč/MWh)' = CALCULATE([Průměrná tržní cena (Kč/MWh)],dim_date[is_weekend] = FALSE (),dim_hour[hour_of_day] >= 9,dim_hour[hour_of_day] <= 20)
		formatString: #,0.00
		lineageTag: 0ae11ce6-78d7-418e-a502-8e998856a1c1

	/// Prostý průměr hodinových cen v noci (20:00–8:00) a o víkendech. Počítá se jako všechny hodiny minus hodiny špičky.
	measure 'Průměrná cena mimo špičku (Kč/MWh)' =
			
			VAR peak_price_sum = CALCULATE(SUM(vw_hourly_cost[price_czk_mwh]),dim_date[is_weekend] = FALSE (),dim_hour[hour_of_day] >=9,dim_hour[hour_of_day] <=20)
			VAR peak_hours = CALCULATE(COUNTROWS(vw_hourly_cost),dim_date[is_weekend] = FALSE (),dim_hour[hour_of_day] >=9,dim_hour[hour_of_day] <=20)
			RETURN
			DIVIDE(SUM(vw_hourly_cost[price_czk_mwh]) - peak_price_sum, COUNTROWS(vw_hourly_cost) - peak_hours)
		formatString: #,0.00
		lineageTag: f3f15748-1691-4ac3-80ff-4dd753dde5be

	/// O kolik je MWh ve špičce dražší než mimo ni. Horní hranice úspory za 1 MWh přesunutou ze špičky do noci nebo na víkend.
	measure 'Rozdíl špička – mimo špičku (Kč/MWh)' = [Průměrná cena ve špičce (Kč/MWh)] - [Průměrná cena mimo špičku (Kč/MWh)]
		formatString: #,0.00
		lineageTag: 751e2906-0a72-4ad9-a8d8-fc3dd187e525

	/// Náklad na silovou elektřinu ve stejném období předchozího roku. Pro rok 2020 prázdné (data za rok 2019 nemám).
	measure 'Náklad na silovou elektřinu minulý rok (Kč)' = CALCULATE([Náklad na silovou elektřinu (Kč)],SAMEPERIODLASTYEAR(dim_date[full_date]))
		formatString: #,0.00
		lineageTag: 98ea1d3e-45a0-47ce-84f6-4ab039c77edb

	/// O kolik Kč se náklad na silovou elektřinu změnil oproti stejnému období předchozího roku. Kladné = zdražení. Pro rok 2020 prázdné.
	measure 'Změna nákladu na silovou elektřinu (Kč)' =
			
			VAR previous_cost = [Náklad na silovou elektřinu minulý rok (Kč)]
			RETURN
			IF(ISBLANK(previous_cost),BLANK(),[Náklad na silovou elektřinu (Kč)] - previous_cost)
		formatString: #,0.00
		lineageTag: fd362449-8b19-4f50-babf-26b54a64b357

	column date_key
		dataType: int64
		formatString: 0
		lineageTag: 9d47deac-43e1-4f6b-b56c-b2947a3176b4
		summarizeBy: none
		sourceColumn: date_key

		annotation SummarizationSetBy = Automatic

	column hour_of_day
		dataType: int64
		formatString: 0
		lineageTag: 09cdf8e2-29df-4855-8d89-a194ceee79cc
		summarizeBy: none
		sourceColumn: hour_of_day

		annotation SummarizationSetBy = Automatic

	column price_eur_mwh
		dataType: double
		lineageTag: 3d0719c8-2983-4a6d-a8e0-06371918a60c
		summarizeBy: sum
		sourceColumn: price_eur_mwh

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column rate_czk_per_eur
		dataType: double
		lineageTag: 602a588e-bf62-455f-84aa-a79c7164c74d
		summarizeBy: sum
		sourceColumn: rate_czk_per_eur

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column price_czk_mwh
		dataType: double
		lineageTag: d033c39e-f4a2-49d9-bcae-b9985a1fc6f4
		summarizeBy: sum
		sourceColumn: price_czk_mwh

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column load_mwh
		dataType: double
		lineageTag: 7564dfb1-8df2-4d93-a34f-17f6620661c2
		summarizeBy: sum
		sourceColumn: load_mwh

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column power_cost_eur
		dataType: double
		lineageTag: 02c3e1b5-1843-4a35-8298-cf66ba89870d
		summarizeBy: sum
		sourceColumn: power_cost_eur

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column power_cost_czk
		dataType: double
		lineageTag: a5ef5480-48b0-4e48-a98f-a91f76f0ee53
		summarizeBy: sum
		sourceColumn: power_cost_czk

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition vw_hourly_cost = m
		mode: import
		source =
				let
				    Zdroj = Sql.Database("localhost", "EnergyCrisisCostAnalysis"),
				    dbo_vw_hourly_cost = Zdroj{[Schema="dbo",Item="vw_hourly_cost"]}[Data]
				in
				    dbo_vw_hourly_cost

	annotation PBI_ResultType = Table

