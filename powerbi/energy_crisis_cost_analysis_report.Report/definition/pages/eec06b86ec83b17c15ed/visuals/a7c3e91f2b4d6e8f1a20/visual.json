          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Jak zajištění funguje: ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "9pt",
                      "color": "#1e1f22"
                    }
                  },
                  {
                    "value": "firma během roku postupně nakoupí část elektřiny na příští rok za pevnou cenu, obvykle přes dodavatele. Kupuje stejné množství na každou hodinu, zbytek platí za cenu z trhu.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#374151"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Pevná cena: ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "9pt",
                      "color": "#1e1f22"
                    }
                  },
                  {
                    "value": "průměrná tržní cena předchozího roku, což odpovídá postupnému nákupu (předpoklad). Karta PXE pro srovnání ukazuje poslední cenu ročního produktu na pražské burze z konce předchozího roku.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#374151"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Proč chybí rok 2020: ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "9pt",
                      "color": "#1e1f22"
                    }
                  },
                  {
                    "value": "pro jeho zajištění by byla potřeba cena z roku 2019, která v datech není.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#374151"
                    }
                  }
                ]
              }
            ]
