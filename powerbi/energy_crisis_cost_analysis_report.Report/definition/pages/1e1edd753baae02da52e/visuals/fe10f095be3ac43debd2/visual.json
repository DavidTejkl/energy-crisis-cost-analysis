    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "O čem report je",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "12pt",
                      "color": "#1e1f22"
                    }
                  }
                ],
                "horizontalTextAlignment": "center"
              },
              {
                "textRuns": [
                  {
                    "value": "Tento report ukazuje, kolik modelová průmyslová firma zaplatila za elektřinu v letech 2020–2024 a co náklad ovlivnilo. Firma nakupuje elektřinu za ceny ",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#374151"
                    }
                  },
                  {
                    "value": "denního trhu OTE",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "11pt",
                      "color": "#374151"
                    }
                  },
                  {
                    "value": ", kde se den předem obchoduje cena pro každou hodinu následujícího dne. Celkový náklad má dvě části: ",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#374151"
                    }
                  },
                  {
                    "value": "silovou elektřinu",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "11pt",
                      "color": "#374151"
                    }
                  },
                  {
                    "value": ", jejíž cena se mění podle trhu, a ",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#374151"
                    }
                  },
                  {
                    "value": "regulované platby",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "11pt",
                      "color": "#374151"
                    }
                  },
                  {
                    "value": " (distribuce, systémové služby, POZE a daň), které stanovuje ERÚ a zákon tzn. firma je nemůže vyjednat. Firma odebírá nejvíc elektřiny ve dne, kdy je dražší, a kvůli tomuto ",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#374151"
                    }
                  },
                  {
                    "value": "diagramu odběru",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "11pt",
                      "color": "#374151"
                    }
                  },
                  {
                    "value": " platí víc, než je průměrná cena trhu. Stránka ",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#374151"
                    }
                  },
                  {
                    "value": "Zajištění ceny",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "11pt",
                      "color": "#374151"
                    }
                  },
                  {
                    "value": " ukazuje, kolik by firma ušetřila nebo ztratila, kdyby část elektřiny nakoupila předem za pevnou cenu.",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#374151"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
    },
